{
  "compilerOptions": {
    "outDir": "dist",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": [
      "es6",
      "dom",
      "es2020",
    ],
    "sourceMap": true,
    "allowJs": false,
    "jsx": "react",
    
    "declaration": true,
    "skipLibCheck": true,
    
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "strict": true,
    "strictNullChecks": false
  },
  "include": [
    "src/index.tsx"
  ]
}
